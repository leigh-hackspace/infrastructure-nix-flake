# whisper-ws — the OpenAI-Realtime-compatible WebSocket gateway that sits in
# front of whisper.cpp.  aibox runs it as `whisper-ws.service`; see
# `machines/aibox/whisper.nix` for the wiring and `README.md` in this directory
# for the protocol.
#
# ## Why this crate is packaged here and not by common/crane.nix
#
# Every other program in `crates/` is a member of the shared cargo workspace and
# is built from `workspaceSrc` with `-p <name>`.  This one cannot be:
#
#   * The binary embeds its status page, which is a Solid.js + Vite app in
#     `web/app`, so something has to run npm *before* cargo: `src/assets.rs` is
#     generated by `web/app/gen_assets.sh` (git-ignored) and `main.rs` does not
#     compile without it.  Cargo loads every member's manifest to build any of
#     them and refuses a manifest whose target files are missing, so a member
#     that cannot compile would put an npm build inside every other crate's
#     dependency derivation.
#   * It depends on zero external crates (house style: stdlib only), so the
#     workspace's one `Cargo.lock` and one vendored dependency tree buy it
#     nothing.
#
# So it lives in `crates/` because it is Rust, opts out of the workspace with its
# own `[workspace]` table — the same mechanism the four Dioxus SPAs use, see the
# header of `crates/Cargo.toml` — is excluded from `workspaceSrc` alongside them
# (`common/crane.nix`), and is built by this file.  `nix build .#whisper-ws` from
# the repo root; the aibox overlay in `flake.nix` puts the same derivation in
# `pkgs.whisper-ws`.
#
# The web app is embedded with `include_bytes!` of absolute store paths, so the
# binary is self-contained: no CDN, nothing leaves the LAN.  The vendored
# OpenWakeWord assets (engine / onnxruntime-web / ONNX models) live outside
# `web/app` and reach the Vite build through `OWW_DIR`.
{
  stdenvNoCC,
  buildNpmPackage,
  rustPlatform,
}: let
  owwAssets = stdenvNoCC.mkDerivation {
    pname = "openwakeword-assets";
    version = "0.1.0";
    src = ./web/openwakeword;
    installPhase = "cp -r . $out";
  };

  # `npm ci` + `npm run build` (via buildNpmPackage's hooks), then the generated
  # Rust asset module.  Only the two outputs the cargo build needs are installed;
  # see web/app/vite.config.ts for the fixed output names this relies on.
  webApp = buildNpmPackage rec {
    pname = "whisper-ws-web";
    version = "0.1.0";
    src = ./web/app;
    nativeBuildInputs = [owwAssets];
    env.OWW_DIR = "${owwAssets}";
    npmDepsHash = "sha256-n2pWVsblxX2Hwy+2eQ42YstvTljwBPjZoUB5JxP+bwI=";
    npmFlags = ["--no-audit" "--no-fund"];
    installPhase = ''
      mkdir -p $out
      cp -r dist $out/dist
      # assets.rs embeds $out/dist via absolute include_bytes! paths.
      bash ./gen_assets.sh $out/dist $out/assets.rs
    '';
  };
in
  rustPlatform.buildRustPackage {
    pname = "whisper-ws";
    version = "0.1.0";
    src = ./.;
    cargoLock.lockFile = ./Cargo.lock;
    # Zero external crates — nothing to fetch from crates.io.
    doCheck = false;

    # src/assets.rs (generated by webApp) embeds ${webApp}/dist via absolute
    # include_bytes! paths, so only the .rs file needs to reach the cargo build.
    nativeBuildInputs = [webApp];
    preBuild = "cp ${webApp}/assets.rs src/assets.rs";
  }
