/*
  Leigh Hackspace — the Pi Room login screen, and the owner of the Halloween scare.

  This is a hand-written SDDM theme rather than a reskin of breeze for one reason:
  SDDM's greeter is the only thing drawing while nobody is logged in, so a
  screensaver has to be part of the theme.  Everything the user can do funnels
  through `activity()`, and after `Knobs.idleSeconds` of nothing the panel goes away
  and Screensaver.qml takes the screen.  Any mouse movement, click or keystroke
  brings it straight back, with the keyboard returned to the field that was in use.

  `Knobs.js` is generated by this theme's Nix package (machines/pi-room-sys/halloween/
  default.nix); it holds the idle delay and the date window.  Outside the window the
  screensaver never arms, so this disarms itself after Halloween rather than waiting
  for someone to remember to turn it off.  `alwaysOn` there overrides the window when
  you are testing in July.

  Kept deliberately close to plain QtQuick 2: the greeter runs inside
  kwin_wayland and has no widget style worth importing, and the only Qt module the
  theme needs beyond QtQuick is QtMultimedia — which SoundPlayer.qml loads through a
  Loader so that a greeter without a working audio backend still gets the visuals.
*/
import QtQuick 2.15
import "Knobs.js" as Knobs

Rectangle {
    id: root

    // The greeter sizes the theme's root item to the screen; these are fallbacks
    // for the moment before the Loader applies its own size.
    width: 1920
    height: 1080
    color: "#000000"

    property int sessionIndex: sessionModel.lastIndex
    property string message: ""
    property bool busy: false

    // One place decides what "someone is here" means.
    function activity() {
        if (screensaver.visible)
            screensaver.dismiss();
        else
            idleTimer.restart();
    }

    function submit() {
        if (busy)
            return;
        busy = true;
        message = "";
        sddm.login(userField.text, pwField.text, sessionIndex);
    }

    Connections {
        target: sddm

        function onLoginSucceeded() {
            root.message = "";
            idleTimer.stop();
            screensaver.dismiss();
        }

        function onLoginFailed() {
            root.busy = false;
            root.message = "Login failed";
            pwField.clear();
            pwField.forceFocus();
            root.activity();
        }

        function onInformationMessage(text) {
            root.busy = false;
            root.message = text;
            root.activity();
        }
    }

    Timer {
        id: idleTimer
        interval: Knobs.idleSeconds * 1000
        repeat: false
        running: true
        onTriggered: screensaver.show()
    }

    // Hover is the only input the panel's own controls do not see: this sits under
    // everything and only reports movement, so clicks still reach what is above it.
    MouseArea {
        anchors.fill: parent
        hoverEnabled: true
        acceptedButtons: Qt.NoButton
        onPositionChanged: root.activity()
        onWheel: root.activity()
    }

    Text {
        id: clock
        anchors.top: parent.top
        anchors.left: parent.left
        anchors.margins: 34
        color: "#333333"
        font.pixelSize: 13
        font.letterSpacing: 2
        text: Qt.formatDateTime(new Date(), "dddd dd MMMM  ·  HH:mm")
    }

    Timer {
        interval: 5000
        repeat: true
        running: true
        onTriggered: clock.text = Qt.formatDateTime(new Date(), "dddd dd MMMM  ·  HH:mm")
    }

    Text {
        anchors.top: parent.top
        anchors.right: parent.right
        anchors.margins: 34
        color: "#333333"
        font.pixelSize: 13
        font.letterSpacing: 2
        text: sddm.hostName
    }

    Column {
        id: panel
        anchors.centerIn: parent
        width: 360
        spacing: 12

        Text {
            anchors.horizontalCenter: parent.horizontalCenter
            bottomPadding: 26
            color: "#8a8a8a"
            font.pixelSize: 12
            font.letterSpacing: 5
            text: "LEIGH HACKSPACE"
        }

        Field {
            id: userField
            width: panel.width
            placeholder: "username"
            nextField: pwField
            onActivity: root.activity()
            onAccepted: pwField.forceFocus()
        }

        Field {
            id: pwField
            width: panel.width
            placeholder: "password"
            echoMode: TextInput.Password
            onActivity: root.activity()
            onAccepted: root.submit()
        }

        Item {
            width: panel.width
            height: 46

            Rectangle {
                id: button
                anchors.right: parent.right
                width: 128
                height: parent.height
                radius: 2
                color: buttonArea.containsMouse ? "#3d0d0d" : "#1a0a0a"
                border.width: 1
                border.color: root.busy ? "#2a2a2a" : "#6e1a1a"

                Text {
                    anchors.centerIn: parent
                    color: root.busy ? "#555555" : "#cfc7c0"
                    font.pixelSize: 14
                    font.letterSpacing: 2
                    text: root.busy ? "waiting" : "sign in"
                }

                MouseArea {
                    id: buttonArea
                    anchors.fill: parent
                    hoverEnabled: true
                    cursorShape: Qt.PointingHandCursor
                    onClicked: root.submit()
                }
            }
        }

        Text {
            anchors.horizontalCenter: parent.horizontalCenter
            width: panel.width
            horizontalAlignment: Text.AlignHCenter
            wrapMode: Text.WordWrap
            color: "#8c2b2b"
            font.pixelSize: 13
            text: root.message
            visible: root.message !== ""
        }
    }

    Row {
        anchors.bottom: parent.bottom
        anchors.horizontalCenter: parent.horizontalCenter
        anchors.bottomMargin: 34
        spacing: 26

        Repeater {
            model: sessionModel

            Text {
                color: root.sessionIndex === index ? "#c4c4c4" : "#5a5a5a"
                font.pixelSize: 12
                font.letterSpacing: 1
                text: model.name

                MouseArea {
                    anchors.fill: parent
                    cursorShape: Qt.PointingHandCursor
                    onClicked: {
                        root.sessionIndex = index;
                        root.activity();
                    }
                }
            }
        }

        Text {
            color: "#5a5a5a"
            font.pixelSize: 12
            font.letterSpacing: 1
            text: "restart"
            visible: sddm.canReboot

            MouseArea {
                anchors.fill: parent
                cursorShape: Qt.PointingHandCursor
                onClicked: sddm.reboot()
            }
        }

        Text {
            color: "#5a5a5a"
            font.pixelSize: 12
            font.letterSpacing: 1
            text: "power off"
            visible: sddm.canPowerOff

            MouseArea {
                anchors.fill: parent
                cursorShape: Qt.PointingHandCursor
                onClicked: sddm.powerOff()
            }
        }
    }

    Screensaver {
        id: screensaver
        anchors.fill: parent

        onDismissed: {
            // Give the keyboard back to whoever was typing, so a keypress that
            // dismisses the scare does not also land in the wrong box.
            if (userField.text.length === 0)
                userField.forceFocus();
            else
                pwField.forceFocus();
            idleTimer.restart();
        }
    }

    Component.onCompleted: {
        // sddm remembers the last user; the Pi Room is shared, but the same few people
        // use these boxes, so not retyping a directory username is worth it.
        if (userModel.lastUser)
            userField.text = userModel.lastUser;

        if (userField.text.length === 0)
            userField.forceFocus();
        else
            pwField.forceFocus();
    }
}
