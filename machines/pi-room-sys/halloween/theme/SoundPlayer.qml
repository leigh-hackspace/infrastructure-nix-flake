/*
  The sounds, and the only file in this theme that imports QtMultimedia.

  It is a separate component on purpose: Screensaver.qml reaches it through a Loader,
  so if the greeter has no QtMultimedia QML module (or no working audio backend) the
  theme still draws every scare and the Loader simply reports Error.  Adding the
  module to the greeter is `services.displayManager.sddm.extraPackages` in
  machines/pi-room-sys/configuration.nix; the wav files are generated by this theme's
  Nix build, so there is nothing to fetch and nothing to license.

  Volumes are per-clip rather than global: whisper and creak sit under a bang by
  design, and the bang is the one that should land.
*/
import QtQuick 2.15
import QtMultimedia

Item {
    id: player

    SoundEffect {
        id: bang
        source: "sounds/bang.wav"
        volume: 0.9
    }

    SoundEffect {
        id: shriek
        source: "sounds/shriek.wav"
        volume: 0.8
    }

    SoundEffect {
        id: whisper
        source: "sounds/whisper.wav"
        volume: 1.0
    }

    SoundEffect {
        id: creak
        source: "sounds/creak.wav"
        volume: 1.0
    }

    SoundEffect {
        id: heartbeat
        source: "sounds/heartbeat.wav"
        volume: 0.85
    }

    function play(name) {
        if (name === "face")
            bang.play();
        else if (name === "static")
            shriek.play();
        else if (name === "eyes" || name === "message")
            whisper.play();
        else if (name === "figure")
            creak.play();
        else if (name === "red")
            heartbeat.play();
    }

    function stopAll() {
        bang.stop();
        shriek.stop();
        whisper.stop();
        creak.stop();
        heartbeat.stop();
    }
}
