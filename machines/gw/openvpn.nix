# The router's VPNs, other than the tailnet: the old box ran two OpenVPN servers
# (`ovpns1`, `ovpns2`) over two TAP devices (`tap0`, `tap1`), which is what its
# generated dnsmasq conf and OPNsense's `<Interfaces>` XML both say.  This is the
# flake's version of that — inert by default, and the reason is at the bottom of
# this comment, so read it before enabling anything here.
#
# WHAT IS PROVEN, from the old box's own generated files:
#
#   * two servers, on TAP devices, i.e. layer-2 tunnels: a client joining one of
#     them is *on* a network rather than routed into one, which is why the devices
#     were bridged and why dnsmasq answered on them (a TAP client takes a lease
#     from the bridge it is attached to, so it needs the same DNS as the LAN it is
#     pretending to be on);
#   * the servers were reachable from the WAN, because the old box's firewall had
#     the matching pass rules.
#
# WHAT IS NOT PROVEN, and every one of these is a fact to read off the old box
# (./README.md says where): the port and protocol of each server, which VLAN or
# bridge each TAP was attached to, the client address pool each one handed out,
# whether clients authenticated with certificates, with authentik, or with a local
# password, and whether either server still had a client in the last year.
#
# WHY IT IS OFF BY DEFAULT rather than written out and enabled: an OpenVPN server
# whose certificates, key direction and client pool are guesses is not a broken but
# visible service — it is a listener on the network's public address with an
# authentication setup nobody has checked.  The tailnet (./uplink.nix) is the
# network's working remote access today, so nothing is blocked by this staying off
# until the facts arrive.  Enabling it is a deliberate act, and `just check` will
# still evaluate it either way.
{
  config,
  lib,
  pkgs,
  ...
}: let
  cfg = config.infra.gw.openvpn;

  # One server.  `config` is raw openvpn config lines — the module has no schema
  # for the server side beyond the unit's own wiring, which is why the values below
  # are TODOs in the config text rather than invented options: an invented option
  # name is a silent no, and a TODO in the file the operator reads is a yes with a
  # question attached.
  server = name: {
    autoStart = true;
    # The unit is a forking service the module writes; the network's never-give-up
    # policy is added to it below rather than here, because the rate-limit half
    # lives on the unit and not in serviceConfig (common/systemd.nix's whole point).
    config = ''
      # GENERATED by machines/gw/openvpn.nix — server `${name}`.
      dev tap${name}
      mode server

      # TODO (needs the old box): the port, the protocol, and whether it is
      # `proto udp` with `tun-ipv6`-style dual-stack or plain v4.  Nothing here
      # guesses, because a wrong port is a server that listens on a port nobody
      # documented.
      #
      # TODO (needs the old box): ca/cert/key, `key-direction`, `tls-server`, and
      # the client-pool + bridge lines that say which network a client lands on.
      # The certificates themselves would be sops secrets declared in
      # machines/gw/sops.nix, referenced by path like every other secret here.
    '';
  };
in {
  options.infra.gw.openvpn = {
    enable = lib.mkEnableOption ''
      the network's OpenVPN servers on this box.  Off until the old box's own server
      configs have been read off it — see the header of this file for what is unknown
      and why an OpenVPN server built from guesses is worse than no OpenVPN server.
    '';

    port = lib.mkOption {
      type = lib.types.port;
      default = 1194;
      description = ''
        The port the servers listen on, and the one number in this file that is a
        default rather than a fact: 1194 is OpenVPN's well-known port and the old box
        may well have used it, but nothing in this repo proves that.  It is an option
        rather than a literal so that the firewall rule below and the server config
        cannot disagree about it when the real number is read off the old box.
      '';
    };
  };

  config = lib.mkIf cfg.enable {
    # The listener's firewall half, here rather than in ./firewall.nix so that the
    # rule cannot outlive the service: ./firewall.nix's input chain is `policy drop`
    # and deliberately has no OpenVPN port in it, because a rule open for a service
    # that is switched off is the mistake this arrangement exists to prevent.
    networking.nftables.tables.openvpnInput = {
      family = "ip";
      name = "ovpnIn";
      content = ''
        chain input {
          type filter hook input priority 0; policy accept;
          udp dport ${toString cfg.port} accept
        }
      '';
    };

    services.openvpn.servers = {
      ovpns1 = server "1";
      ovpns2 = server "2";
    };

    # A VPN server that has lost its tunnel after a power cut is a network that
    # cannot be reached from outside it, which is exactly when that matters.
    systemd.services = builtins.listToAttrs (
      map
      (n: {
        name = "openvpn-${n}";
        value = {
          serviceConfig = {
            Restart = lib.mkOverride 50 "always";
            RestartSec = lib.mkOverride 50 "5";
          };
          startLimitIntervalSec = lib.mkOverride 50 0;
        };
      })
      ["ovpns1" "ovpns2"]
    );

    # The TAP devices are bridges' members, so the bridge devices have to exist
    # before openvpn attaches to them.  Which bridge, and on which VLAN, is one of
    # the TODOs above; when it is known, the bridge device belongs in
    # ./networking.nix next to the VLANs it is made of.
    systemd.network.enable = true;
  };
}
